{
  "info": { "name": "HustleHub+ Part 1", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "variable": [{ "key": "baseUrl", "value": "https://localhost:3443" }, { "key": "token", "value": "" }, { "key": "email", "value": "student{{$timestamp}}@example.com" }],
  "item": [
    { "name": "Health", "request": { "method": "GET", "url": "{{baseUrl}}/api/health" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Health is OK', () => pm.response.to.have.status(200));"] } }] },
    { "name": "Register", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Demo Freelancer\",\n  \"email\": \"{{email}}\",\n  \"password\": \"StrongPass123!\",\n  \"role\": \"freelancer\"\n}" }, "url": "{{baseUrl}}/api/auth/register" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Registered', () => pm.response.to.have.status(201));"] } }] },
    { "name": "Login", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"StrongPass123!\"\n}" }, "url": "{{baseUrl}}/api/auth/login" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Logged in', () => pm.response.to.have.status(200));", "pm.environment.set('token', pm.response.json().token);"] } }] },
    { "name": "Protected Me", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/auth/me" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Protected route works', () => pm.response.to.have.status(200));"] } }] },
    { "name": "Invalid Login", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"wrong-password\"\n}" }, "url": "{{baseUrl}}/api/auth/login" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Invalid login rejected', () => pm.response.to.have.status(401));"] } }] },
    { "name": "Invalid Registration", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"A\",\n  \"email\": \"not-an-email\",\n  \"password\": \"123\"\n}" }, "url": "{{baseUrl}}/api/auth/register" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Invalid registration rejected', () => pm.response.to.have.status(400));"] } }] }
  ]
}
