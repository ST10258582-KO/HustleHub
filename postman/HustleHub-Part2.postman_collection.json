                  "const json = pm.response.json();",
                  "pm.test('Has error', () => pm.expect(json.error).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{clientToken}}" },
              { "key": "Content-Type",   "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"Illegal gig\",\"description\":\"This should not work at all ever.\",\"price\":100}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/gigs",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gigs"]
            }
          }
        },
        {
          "id": "req-gig-6",
          "name": "XSS Attempt (negative)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('XSS content rejected or sanitised', () => {",
                  "  const status = pm.response.status;",
                  "  pm.expect([400, 201]).to.include(status);",
                  "  if (status === 201) {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.gig.title).to.not.include('<script>');",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{freelancerToken}}" },
              { "key": "Content-Type",   "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"<script>alert('xss')</script>\",\"description\":\"<img src=x onerror=alert(1)>This is a description long enough\",\"price\":100}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/gigs",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gigs"]
            }
          }
        }
      ]
