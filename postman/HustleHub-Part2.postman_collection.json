    {
      "name": "Bookings",
      "item": [
        {
          "id": "req-book-1",
          "name": "Book Gig (client)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('Has booking', () => pm.expect(json.booking).to.be.an('object'));",
                  "pm.test('Has transaction', () => pm.expect(json.transaction).to.be.an('object'));",
                  "pm.test('Amounts match', () => pm.expect(json.booking.amount).to.equal(json.transaction.amount));",
