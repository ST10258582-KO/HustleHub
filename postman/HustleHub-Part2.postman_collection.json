        {
          "id": "req-book-4",
          "name": "Finance Dashboard (freelancer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Has totalIncome', () => pm.expect(json.totalIncome).to.be.a('number'));",
                  "pm.test('Has estimatedTax', () => pm.expect(json.estimatedTax).to.be.a('number'));",
                  "pm.test('Has netAfterEstimatedTax', () => pm.expect(json.netAfterEstimatedTax).to.be.a('number'));",
                  "pm.test('Tax is 20% of income', () => pm.expect(json.estimatedTax).to.be.closeTo(json.totalIncome * 0.20, 0.01));",
                  "pm.test('Net is income minus tax', () => pm.expect(json.netAfterEstimatedTax).to.be.closeTo(json.totalIncome - json.estimatedTax, 0.01));",
                  "pm.test('Has transactions array', () => pm.expect(json.transactions).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{freelancerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/bookings/finance",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", "finance"]
            }
